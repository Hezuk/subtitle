ANTHROPIC_API_KEY=여기에_API_키를_입력하세요
GEMINI_API_KEY=여기에_API_키를_입력하세요

# ── 선택 설정 (기본값이 있어 생략 가능) ──────────────────────────────────────
# DEFAULT_TRANSLATION_MODEL=claude
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=16384
# ANTHROPIC_TIMEOUT=300
# ANTHROPIC_RETRANSLATE_TIMEOUT=60
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_TIMEOUT=300
# GEMINI_RETRANSLATE_TIMEOUT=60
# GEMINI_RETRY_ATTEMPTS=4
# GEMINI_RETRY_BASE_DELAY=1.5
# GEMINI_RETRY_MAX_DELAY=12
# GEMINI_TRANSLATE_BATCH=120
# GEMINI_REVIEW_BATCH=250
# WHISPER_MODEL=large-v3-turbo
# WHISPER_LANGUAGE=ko
# WHISPER_FP16=false
# FFMPEG_SUBTITLE_STYLE=FontName=Arial,FontSize=20,PrimaryColour=&HFFFFFF,OutlineColour=&H000000,Outline=2,Bold=1,Alignment=2
# FFMPEG_CRF=18
# FFMPEG_PRESET=fast
# FFMPEG_TIMEOUT=7200
# MAX_UPLOAD_MB=4096
# MAX_BLOCKS=5000
# MAX_TEXT_LEN=1000
# MAX_REQUIREMENT_LEN=500
# MAX_SUBTITLE_CHARS=42
# MAX_RETRIES=2
# STALE_DAYS=7
# ORPHAN_HOURS=24
